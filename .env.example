# Copy to `.env` and fill in values. Optional sections can stay empty.

# --- LLM (GigaChat по умолчанию; задайте LLM_PROVIDER для ollama/openrouter) ---
LLM_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat
# Отдельная модель LLM-as-judge; по умолчанию GigaChat-2-Pro.
# GIGACHAT_JUDGE_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false
GIGACHAT_TIMEOUT=120
# Fail-closed reserve for live/experiment chat or judge runs using Ultra.
# GIGACHAT_ULTRA_TOKEN_FLOOR=15000000
# GIGACHAT_ULTRA_RESERVE_PER_SCENARIO=250000

# --- Ollama (optional) ---
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT=120
# OLLAMA_TEMPERATURE=0
# OLLAMA_REASONING=false

# --- Opt-in live tests and bounded E1–E5 experiments ---
# LIVE_AGENT_DB_PATH=/absolute/path/to/excel_data.db
# HTTP deadline for one local Flask /chat exchange (seconds, default: 300).
# LIVE_AGENT_HTTP_TIMEOUT=300
# WORKER_CAPABILITY_REROUTE_EXPERIMENT=1
# WORKER_SPLIT_TOOL_CALL_EXPERIMENT=0
# OPERATION_SQL_RISK_ASPECTS_EXPERIMENT=1
# Prompt-only protocol variant used by the isolated operation matrix runner.
# OPERATION_SQL_RISK_PROTOCOL_EXPERIMENT=current
# Exact-scope/evidence experiment for typed SQL-risk operations:
# 0/default = off; typed_plan = structured router contract + code-owned plan.
# Legacy truthy/prompt values are rejected instead of selecting another path.
# OPERATION_SQL_RISK_SCOPE_EVIDENCE_EXPERIMENT=0

# --- Excel header classifier ---
# CATBOOST_HEADER_MODEL_PATH=models/catboost_header_model.cbm

# --- Local embeddings (optional; default model used if unset) ---
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Neo4j lineage (optional; NEO4J_USER is accepted as alias for NEO4J_USERNAME) ---
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change_me
# NEO4J_DATABASE=neo4j

# --- Langfuse tracing (optional) ---
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TRACING_ENVIRONMENT=development
